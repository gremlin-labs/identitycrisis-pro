{
  "name": "identitycrisis-pro",
  "version": "1.0.0",
  "description": "IdentityCrisis Pro - A modern identity generator application",
  "main": "src/main.js",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-vm-modules vite build && electron .",
    "dev:electron": "NODE_OPTIONS=--experimental-vm-modules concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "NODE_OPTIONS=--experimental-vm-modules vite build",
    "start": "NODE_OPTIONS=--experimental-vm-modules vite build && electron .",
    "dist": "electron-builder",
    "dist:all": "electron-builder --mac --win --linux",
    "generate-icons": "echo 'Icons are already generated in public/icons/. To regenerate, use: npx electron-icon-maker --input=public/icon-master-2048.png --output=public/icons'"
  },
  "author": {
    "name": "gremlinlabs",
    "email": "ej@gremlinlabs.com"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "electron-store": "^11.0.2",
    "idb": "^8.0.3",
    "phosphor-react": "^1.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "jest": "^30.2.0",
    "lighthouse": "^13.0.1",
    "playwright": "^1.56.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "vite": "^7.1.12",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.identitycrisis.pro",
    "productName": "IdentityCrisis Pro",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icons/icon.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "public/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "icon": "public/icons/1024x1024.png",
      "category": "Utility",
      "maintainer": "ej@gremlinlabs.com"
    }
  }
}
