{
  "name": "identitycrisis-pro",
  "version": "1.0.0",
  "description": "IdentityCrisis Pro - A modern identity generator application",
  "main": "src/main.js",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-vm-modules vite build && electron .",
    "dev:electron": "NODE_OPTIONS=--experimental-vm-modules concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "NODE_OPTIONS=--experimental-vm-modules vite build",
    "start": "NODE_OPTIONS=--experimental-vm-modules vite build && electron .",
    "dist": "electron-builder",
    "dist:all": "electron-builder --mac --win --linux",
    "generate-icons": "electron-icon-builder --input=public/icon-master-2048.png --output=public/ --flatten"
  },
  "author": {
    "name": "gremlinlabs",
    "email": "ej@gremlinlabs.com"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "electron-store": "^10.1.0",
    "idb": "^8.0.3",
    "phosphor-react": "^1.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "electron": "^37.2.2",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "jest": "^30.0.4",
    "lighthouse": "^12.8.0",
    "playwright": "^1.54.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.identitycrisis.pro",
    "productName": "IdentityCrisis Pro",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "public/icons/icon.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "win": {
      "target": ["nsis", "zip"],
      "icon": "public/icons/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb", "tar.gz"],
      "icon": "public/icons/1024x1024.png",
      "category": "Utility",
      "maintainer": "ej@gremlinlabs.com"
    }
  }
}